    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ m_d_l.id }}</td>
            </tr>
            <tr>
                <th>Cheque</th>
                <td>{{ m_d_l.cheque ? 'Yes' : 'No' }}</td>
