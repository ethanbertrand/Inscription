{% extends 'base.html.twig' %}

{% block title %}ParentsEleve index{% endblock %}

{% block body %}
    <h1>ParentsEleve index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for parents_eleve in parents_eleves %}
            <tr>
                <td>{{ parents_eleve.id }}</td>
                <td>
                    <a href="{{ path('app_parents_eleve_show', {'id': parents_eleve.id}) }}">show</a>
                    <a href="{{ path('app_parents_eleve_edit', {'id': parents_eleve.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_parents_eleve_new') }}">Create new</a>
{% endblock %}
