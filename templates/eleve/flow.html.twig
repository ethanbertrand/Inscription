{% extends 'base.html.twig' %}

{% block title %}{{ eleve.id ? 'Modifier' : 'Créer' }} un élève{% endblock %}

{% block body %}
    <main id="contenu">
        <div class="fr-container">
            <nav class="fr-breadcrumb" aria-label="Vous êtes ici :">
                <ol class="fr-breadcrumb__list">
                    <li>
                        <a class="fr-breadcrumb__link" href="{{ path('app_acceuil') }}">Accueil</a>
                    </li>
                    <li>
                        <a class="fr-breadcrumb__link" href="{{ path('app_eleve_index') }}">Élèves</a>
                    </li>
                    <li>
                        <a class="fr-breadcrumb__link" aria-current="page">
                            {{ eleve.id ? 'Modifier' : 'Créer' }} un élève
                        </a>
                    </li>
                </ol>
            </nav>

            <section class="crud-page flow-page" aria-labelledby="titre-page">
                <div class="crud-page__intro">
                    <p class="fr-badge fr-badge--blue-france">Inscription</p>
                    <h1 id="titre-page">{{ eleve.id ? 'Modifier' : 'Créer' }} un élève</h1>
                    <p class="fr-text--lead">
                        Complétez les étapes successives pour {{ eleve.id ? 'mettre à jour le dossier' : 'créer le dossier' }}
                        de l'élève.
                    </p>
                </div>

                <turbo-frame id="eleve-flow" class="flow-card">
                    <div class="flow-progress" aria-labelledby="titre-progression">
                        <h2 id="titre-progression" class="fr-sr-only">Progression du formulaire</h2>
                        <p class="flow-progress__label">
                            Étape {{ form_flow_step_index(form) + 1 }} sur {{ form_flow_total_steps(form) }}
                        </p>
                        <p class="flow-progress__current">{{ form_flow_current_step(form) }}</p>
                        <ol class="flow-steps">
                            {% for step in form.vars.visible_steps %}
                                <li class="{{ step.is_current_step ? 'flow-step--current' : '' }}"
                                    {% if step.is_current_step %}aria-current="step"{% endif %}>
                                    <span class="flow-step__number">{{ loop.index }}</span>
                                    <span>{{ step.name }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>

                    <div class="flow-form">
{{ form_start(form, { attr: { class: 'crud-form', 'data-turbo': 'false' } }) }}
    <div class="crud-form__fields">
        {{ form_widget(form) }}
    </div>
{{ form_end(form) }}
                    </div>
                </turbo-frame>

                <a class="fr-link fr-icon-arrow-left-line fr-link--icon-left crud-back-link"
                   href="{{ path('app_eleve_index') }}">
                    Retour à la liste des élèves
                </a>
            </section>
        </div>
    </main>
// Script qui permet de vérifier le format du fichier image avant l'envoi du formulaire
<script>
document.addEventListener('change', (event) => {
    const input = event.target;
    if (!input.matches('input[type="file"][name$="[photoFile]"]')) {
        return;
    }

    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
    const file = input.files[0];

    if (file && !allowed.includes(file.type)) {
        alert('Format non autorisé. Choisissez une image JPEG, PNG ou WebP.');
        input.value = '';
    }
});
</script>

//Script pour les transports pour savoir si plaque d'immatriculation est obligatoire ou non
<script>
(() => {
    const form = document.querySelector('form.crud-form') ?? document.querySelector('form');
    const list = form.querySelector('.js-transports');
    if (!list) return;   // pas sur cette étape

    let index = list.children.length;

    const toggle = (row, visible) => {
    if (!row) return;
    row.hidden = !visible;
    // un champ désactivé n'est pas envoyé : la valeur sera vide côté serveur
    row.querySelectorAll('input').forEach((el) => { el.disabled = !visible; });
};

const refreshEntry = (entry) => {
    const select = entry.querySelector('.js-type-transport');
    if (!select) return;
    const option = select.selectedOptions[0];

    toggle(entry.querySelector('.js-row-plaque'), option?.dataset.plaque === '1');
    toggle(entry.querySelector('.js-row-ligne'), option?.dataset.ligne !== '0');
};

    const decorate = (entry) => {
        if (!entry.querySelector('.js-remove')) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'js-remove';
            btn.textContent = 'Supprimer ce transport';
            btn.addEventListener('click', () => entry.remove());
            entry.appendChild(btn);
        }
        refreshEntry(entry);
    };

    const add = document.createElement('button');
    add.type = 'button';
    add.textContent = 'Ajouter un transport';
    add.addEventListener('click', () => {
        const wrapper = document.createElement('div');
        wrapper.innerHTML = list.dataset.prototype.replace(/__name__/g, index++);
        list.appendChild(wrapper);
        decorate(wrapper);
    });
    list.after(add);

    [...list.children].forEach(decorate);
    form.addEventListener('change', () => [...list.children].forEach(refreshEntry));
})();
</script>
<script>
(() => {
    const form = document.querySelector('form.crud-form') ?? document.querySelector('form');
    const check = form.querySelector('input[type="checkbox"][name$="[mdl_eleve][Adhesion]"]');
    const rows = form.querySelectorAll('.js-row-mdl');
    if (!check || rows.length === 0) return;   // pas sur cette étape

    const refresh = () => {
        rows.forEach((row) => {
            row.hidden = !check.checked;
            // un champ désactivé n'est pas envoyé : il sera vide côté serveur
            row.querySelectorAll('input').forEach((el) => { el.disabled = !check.checked; });
        });
    };

    check.addEventListener('change', refresh);
    refresh();   // état initial (reprise d'un brouillon)
})();
</script>
{% endblock %}