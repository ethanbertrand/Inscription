{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    {% include 'header.html.twig' %}
    


    <main id="contenu">
        <div class="fr-container">
            <nav role="navigation" class="fr-breadcrumb" aria-label="Vous êtes ici :">
                <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb-1">
                    Voir le fil d’Ariane
                </button>
                <div class="fr-collapse" id="breadcrumb-1">
                    <ol class="fr-breadcrumb__list">
                        <li>
                            <a class="fr-breadcrumb__link" aria-current="page">Accueil</a>
                        </li>
                    </ol>
                </div>
            </nav>

            <section class="fr-mb-8w" aria-labelledby="titre-principal">
                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
                    <div class="fr-col-12 fr-col-md-8">
                        <p class="fr-badge fr-badge--blue-france fr-mb-2w">Service d'inscription</p>
                        <h1 id="titre-principal">Inscrivez-vous en BTS</h1>
                        <p class="fr-text--lead">
                            Retrouvez les formations proposées et déposez votre dossier d'inscription
                            en quelques étapes.
                        </p>
                        <a class="fr-btn" href="#formations">Découvrir les formations</a>
                    </div>
                </div>
            </section>

            <section id="formations" class="fr-mb-8w" aria-labelledby="titre-formations">
                <h2 id="titre-formations">Les formations proposées</h2>
                <div class="fr-grid-row fr-grid-row--gutters">
                    <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
                        <article class="fr-card fr-enlarge-link">
                            <div class="fr-card__body">
                                <div class="fr-card__content">
                                    <h3 class="fr-card__title"><a href="#inscription">BTS MCO</a></h3>
                                    <p class="fr-card__desc">Management commercial opérationnel.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                    <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
                        <article class="fr-card fr-enlarge-link">
                            <div class="fr-card__body">
                                <div class="fr-card__content">
                                    <h3 class="fr-card__title"><a href="#inscription">BTS NDRC</a></h3>
                                    <p class="fr-card__desc">Négociation et digitalisation de la relation client.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                    <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
                        <article class="fr-card fr-enlarge-link">
                            <div class="fr-card__body">
                                <div class="fr-card__content">
                                    <h3 class="fr-card__title"><a href="#inscription">BTS CG</a></h3>
                                    <p class="fr-card__desc">Comptabilité et gestion.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                    <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
                        <article class="fr-card fr-enlarge-link">
                            <div class="fr-card__body">
                                <div class="fr-card__content">
                                    <h3 class="fr-card__title"><a href="#inscription">BTS SIO</a></h3>
                                    <p class="fr-card__desc">Services informatiques aux organisations.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section id="inscription" class="fr-callout fr-mb-8w" aria-labelledby="titre-inscription">
                <h2 id="titre-inscription" class="fr-callout__title">Préparer votre inscription</h2>
                <p>
                    Munissez-vous de vos informations personnelles et de vos justificatifs avant de commencer.
                </p>
                <a class="fr-btn fr-btn--secondary" href="{{ path('app_page1') }}">Commencer l'inscription</a>
            </section>
        </div>
    </main>

{% include 'footer.html.twig' %}
{% endblock %}